@startuml
title Film Photography Contest Platform - Component Diagram
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor Administrator
actor Organizer
actor Judge
actor Participant

package "Presentation / API Boundary" {
  [Web and SSMS Clients] as client
  [Application API] as api
}

package "Business Components" {
  [Identity and Access] as iam
  [Contest Management] as contest
  [Registration] as registration
  [Film Asset Management] as film
  [Submission Management] as submission
  [Verification] as verification
  [Judging] as judging
  [Result and Award] as result
  [Digital Archive] as archive
  [Audit and Reporting] as audit
  [AI and Analytics Adapter] as ai
}

database "SQL Server\nFilmContestDB" as db
cloud "Object Storage\nImage URI / Path" as storage
cloud "External AI Service" as aiService

Administrator --> client
Organizer --> client
Judge --> client
Participant --> client
client --> api

api --> iam
api --> contest
api --> registration
api --> film
api --> submission
api --> verification
api --> judging
api --> result
api --> archive
api --> audit

registration --> contest : eligibility and contest status
submission --> registration : approved registration
submission --> film : frame provenance
submission --> verification : create verification case
verification --> ai : request advisory analysis
verification --> judging : verified submission
judging --> contest : rounds and criteria
result --> judging : aggregate finalized scores
archive --> result : finalized result snapshot

film --> storage
submission --> storage
archive --> storage
ai --> aiService

iam --> db
contest --> db
registration --> db
film --> db
submission --> db
verification --> db
judging --> db
result --> db
archive --> db
audit --> db

note right of ai
AI returns flags, confidence and analysis data only.
Verification and final business decisions remain human-owned.
end note

note bottom of db
Schemas: iam, participant, reference, contest, film,
submission, verification, judging, result, archive, audit, reporting
end note
@enduml
