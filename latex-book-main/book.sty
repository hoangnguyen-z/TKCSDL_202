% --- Format table of contents ---

% Customize table of contents
\usepackage{tocloft}

% Set title names
\renewcommand{\contentsname}{Mục lục}
\renewcommand{\listtablename}{Danh sách bảng}
\renewcommand{\listfigurename}{Danh sách hình vẽ}

% Include only parts, chapters, and sections
\setcounter{tocdepth}{1}

% Set title formatting in TOC, LOT, LOF to bold centered uppercase
\renewcommand{\cfttoctitlefont}{\hfill\bfseries\huge\MakeUppercase}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\bfseries\huge\MakeUppercase}
\renewcommand{\cftafterlottitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\bfseries\huge\MakeUppercase}
\renewcommand{\cftafterloftitle}{\hfill}

% Set entry fonts
\renewcommand{\cftpartfont}{\bfseries}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftsecfont}{\normalfont}

% Set page fonts
\renewcommand{\cftchappagefont}{\bfseries}
\renewcommand{\cftsecpagefont}{\normalfont}

% Remove dots for chapters
\renewcommand{\cftchapdotsep}{\cftnodots}

% Set title spacing for TOC, LOT, LOF (dồn tiêu đề lên trên)
\setlength{\cftbeforetoctitleskip}{-1.0cm}
\setlength{\cftaftertoctitleskip}{1.2em}
\setlength{\cftbeforelottitleskip}{-1.0cm}
\setlength{\cftafterlottitleskip}{1.2em}
\setlength{\cftbeforeloftitleskip}{-1.0cm}
\setlength{\cftafterloftitleskip}{1.2em}

% Set vertical spaces between entries
\setlength{\cftbeforepartskip}{0.6em}
\setlength{\cftbeforechapskip}{0.4em}
\setlength{\cftbeforesecskip}{0em}

% Align all numbers
\setlength{\cftsecindent}{0em}

% Set entry indentations
\setlength{\cftchapnumwidth}{3em}
\setlength{\cftsecnumwidth}{4em}

% ---- Format headings ----

% Customize section headings
\usepackage{titlesec}

% ---- Format Part & Chapter liền mạch ----
\newif\ifafterpart
\afterpartfalse

\makeatletter
\renewcommand\part{%
  \if@openright
    \cleardoublepage
  \else
    \clearpage
  \fi
  \thispagestyle{plain}%
  \secdef\@part\@spart
}

\def\@part[#1]#2{%
  \ifnum \c@secnumdepth >-2\relax
    \refstepcounter{part}%
    \addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  \markboth{}{}%
  {\centering
   \interlinepenalty \@M
   \normalfont
   \vspace*{0.2cm}%
   {\rule{\textwidth}{1.2pt}}\par\vspace{0.35cm}%
   {\fontsize{16pt}{20pt}\selectfont\bfseries\MakeUppercase{Phần \thepart}}\par\vspace{0.25cm}%
   {\fontsize{15pt}{19pt}\selectfont\bfseries\MakeUppercase{#2}}\par\vspace{0.35cm}%
   {\rule{\textwidth}{1.2pt}}\par}%
   \vspace{1.0cm}%
   \global\afterparttrue
   \@afterheading
}

\def\@spart#1{%
  {\centering
   \interlinepenalty \@M
   \normalfont
   \vspace*{0.2cm}%
   {\rule{\textwidth}{1.2pt}}\par\vspace{0.35cm}%
   {\fontsize{15pt}{19pt}\selectfont\bfseries\MakeUppercase{#1}}\par\vspace{0.35cm}%
   {\rule{\textwidth}{1.2pt}}\par}%
   \vspace{1.0cm}%
   \global\afterparttrue
   \@afterheading
}

% Định nghĩa lại \chapter để không ngắt trang nếu đi liền sau \part
\renewcommand\chapter{%
  \ifafterpart
    \global\afterpartfalse
  \else
    \if@openright\cleardoublepage\else\clearpage\fi
  \fi
  \thispagestyle{plain}%
  \global\@topnum\z@
  \@afterindentfalse
  \secdef\@chapter\@schapter
}
\makeatother

% Format chapter headings: viết liền mạch trên 1 dòng: CHƯƠNG X. TÊN CHƯƠNG (Heading 1: in hoa bôi đậm)
\titleformat{\chapter}[block]
  {\fontsize{14pt}{18pt}\selectfont\bfseries}
  {\MakeUppercase{\chaptertitlename\ \thechapter.}\hspace{0.5em}}
  {0pt}
  {\MakeUppercase}
  [\vskip 0.8ex]

% Format unnumbered chapter headings: Lời cảm ơn, Danh sách thành viên, Lời nói đầu,... (Heading 1: in hoa bôi đậm)
\titleformat{name=\chapter,numberless}[block]
  {\fontsize{15pt}{19pt}\selectfont\bfseries\centering}
  {}
  {0pt}
  {\MakeUppercase}
  [\vskip 1.2ex]

% Adjust chapter spacing
\titlespacing*{\chapter}{0pt}{-10pt}{14pt}
\titlespacing*{name=\chapter,numberless}{0pt}{-10pt}{14pt}

% Heading 2 (bậc 2: 1.1, 1.2,...): Bôi đậm, viết bình thường
\titleformat{\section}[block]
  {\fontsize{12pt}{16pt}\selectfont\bfseries}
  {\thesection.\hspace{0.5em}}
  {0pt}
  {}
  [\vskip 0.4ex]

% Heading 3 (bậc 3: 1.1.1, 1.1.2,...): Không bôi đậm, viết bình thường
\titleformat{\subsection}[block]
  {\fontsize{11pt}{15pt}\selectfont\normalfont}
  {\thesubsection.\hspace{0.5em}}
  {0pt}
  {}
  [\vskip 0.3ex]

% Heading bậc 4: Không bôi đậm, nghiêng nhẹ
\titleformat{\subsubsection}[block]
  {\fontsize{11pt}{15pt}\selectfont\normalfont\itshape}
  {\thesubsubsection.\hspace{0.5em}}
  {0pt}
  {}
  [\vskip 0.2ex]

% Adjust section spacing (tighten gap before and after headings)
\titlespacing*{\section}{0pt}{1.2ex plus .2ex minus .1ex}{0.5ex plus .1ex}
\titlespacing*{\subsection}{0pt}{1.0ex plus .2ex minus .1ex}{0.4ex plus .1ex}
\titlespacing*{\subsubsection}{0pt}{0.8ex plus .1ex minus .1ex}{0.3ex plus .1ex}

% Format paragraph headings
\titleformat{\paragraph}[runin]{\bfseries}{}{0pt}{}[.\hspace{0.8em}]
\titlespacing*{\paragraph}{0pt}{1.0ex plus .2ex minus .1ex}{0.8em}

% Add period after heading numbers
\titlelabel{\thetitle.\hspace{1em}}

% ---- Format theorems and proofs ----

% Enhance theorem environments
\usepackage{amsthm}

% Define theorem style
\newtheoremstyle{paper}{0.5em}{0.5em}{\itshape}{}{\scshape}{.}{1em}{}

% Apply theorem style
\theoremstyle{paper}

% Define theorems
\newtheorem{theorem}{theorem}[chapter]
\newtheorem{proposition}{proposition}[chapter]
\newtheorem{lemma}{lemma}[chapter]
\newtheorem{corollary}{corollary}[chapter]
\newtheorem{definition}{definition}[chapter]
\newtheorem{assumption}{assumption}[chapter]
\newtheorem{remark}{remark}[chapter]
\newtheorem{result}{result}[chapter]

% Enable patching and appending to commands
\usepackage{etoolbox}

% Format proof environment
\renewenvironment{proof}[1][\proofname]{\par\parskip0pt\pushQED{\qed}\normalfont\topsep0.5em\relax\trivlist\item[\hskip\labelsep\upshape\scshape#1\@addpunct{.}\hspace{1em}]\ignorespaces}{\popQED\endtrivlist\@endpefalse}

% ---- Format figures and tables ----

% Include graphics
\usepackage{graphicx}

% Enhance table formatting
\usepackage{booktabs}
\usepackage{tabularx}
\usepackage[section]{placeins}

% Format verbatim font size
\BeforeBeginEnvironment{verbatim}{\footnotesize}

% Allow line break after underscore in identifiers
\renewcommand{\_}{\textunderscore\allowbreak}

% Enable rotation of tables and figures
\usepackage{rotating}

% Enable multiple rows in table
\usepackage{multirow}

% Float parameters for better placement and packing
\renewcommand{\topfraction}{0.95}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.05}
\renewcommand{\floatpagefraction}{0.90}
\setcounter{topnumber}{4}
\setcounter{bottomnumber}{3}
\setcounter{totalnumber}{6}

% Tighten spacing between floats and surrounding text
\setlength{\textfloatsep}{10pt plus 2pt minus 2pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}
\setlength{\floatsep}{10pt plus 2pt minus 2pt}

% Center figures and tables
\makeatletter\g@addto@macro\@floatboxreset\centering\makeatother 

% Adjust spacing in tables
\renewcommand{\arraystretch}{1.15}

% Set font size in tables
\BeforeBeginEnvironment{tabular*}{\footnotesize}

% Write "Bảng" and "Hình" in bold
\renewcommand{\tablename}{\textbf{Bảng}}
\renewcommand{\figurename}{\textbf{Hình}}

% Customize captions
\usepackage{caption, subcaption}

% Format label separator
\DeclareCaptionLabelSeparator{colonsep}{: }

% Format captions with standard academic style
\captionsetup{labelsep=colonsep, labelfont=bf, font=small, skip=6pt}

% Place table captions above table
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}

% Format subcaptions
\captionsetup[sub]{labelformat=simple, labelsep=colonsep, size=footnotesize}

% Use capitals for figure sublabels
\renewcommand{\thesubfigure}{\Alph{subfigure}}

% Create note for tables and figures
\NewDocumentCommand{\note}{o m}{%
\parbox{\linewidth}{\footnotesize\vspace*{10pt}%
\IfValueT{#1}{\textit{#1}.\hspace{1em}}%
#2}}

% ---- Adjust tolerance for page breaks in equations ----

\AtBeginDocument{\allowdisplaybreaks[1]}

% ---- Format lists ----

% Customize lists
\usepackage{enumitem}

% Format itemized lists
\setlist[itemize, 1]{leftmargin=\parindent, label=\color{gray}{\upshape\textbullet}, topsep=0.5em, itemsep=0.5em, parsep=0pt} % First level
\setlist[itemize, 2]{leftmargin=2\parindent, label=\color{gray}{\upshape\textendash}, topsep=0.25em, itemsep=0.25em, parsep=0pt} % Second level

% Format numbered lists
\setlist[enumerate, 1]{leftmargin=\parindent, label=\color{gray}{\upshape\arabic*.}, topsep=0.5em, itemsep=0.5em, parsep=0pt} % First level
\setlist[enumerate, 2]{leftmargin=2\parindent, label=\color{gray}{\upshape\Alph*.}, topsep=0.25em, itemsep=0.25em, parsep=0pt} % Second level

% ---- Format appendix ----

\apptocmd{\appendix}{%
  \titleformat{\chapter}[block]
    {\fontsize{14pt}{18pt}\selectfont\bfseries}
    {\MakeUppercase{Phụ lục\ \thechapter.}\hspace{0.5em}}
    {0pt}
    {\MakeUppercase}
    [\vskip 0.8ex]%
  \titlespacing*{\chapter}{0pt}{-10pt}{14pt}%
}{}{}

